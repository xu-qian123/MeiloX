<?xml version="1.0" encoding="utf-8"?>
<!--
  Round variant. It reuses the same three layers as ic_launcher.xml; Android
  applies the circular mask for this variant, so no separate assets are needed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/chaoge_launcher_bg"/>
    <foreground android:drawable="@drawable/chaoge_launcher_fg"/>
    <monochrome android:drawable="@drawable/chaoge_launcher_mono"/>
</adaptive-icon>
